# ══════════════════════════════════════════════════════════════════
# FLOWUP ADMIN FRONTEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Backend API URL (include /api suffix)
# Dev: http://localhost:5000/api
# Prod: https://your-backend.onrender.com/api
VITE_API_URL=

# Socket.IO server URL (backend root, no /api)
# Dev: http://localhost:5000
# Prod: https://your-backend.onrender.com
VITE_SOCKET_URL=

# Restaurant identifier — must match RESTAURANT_ID in backend .env
VITE_RESTAURANT_ID=

# Customer frontend URL — used to generate table QR codes + share links
# Public URL format (root-level slug): {VITE_CUSTOMER_URL}/{slug}
# QR format: {VITE_CUSTOMER_URL}/{slug}?table={N}
# Dev: http://localhost:5174
# Prod: https://app.flowup.co.in
VITE_CUSTOMER_URL=

# Staff/Waiter frontend URL — used for login link sharing
# Dev: http://localhost:5176
# Prod: https://staff.flowup.co.in
VITE_WAITER_URL=
