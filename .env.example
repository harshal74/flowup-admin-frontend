# ══════════════════════════════════════════════════════════════════
# FLOWUP ADMIN FRONTEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Backend API URL (include /api suffix)
# Dev: http://localhost:5000/api
# Prod: https://your-backend.onrender.com/api
VITE_API_URL=

# Socket.IO server URL (backend root, no /api)
# Dev: http://localhost:5000
# Prod: https://your-backend.onrender.com
VITE_SOCKET_URL=

# Restaurant identifier — must match RESTAURANT_ID in backend .env
VITE_RESTAURANT_ID=

# Customer frontend URL — used to generate table QR codes
# Dev: http://localhost:5173
# Prod: https://your-customer-app.netlify.app
VITE_CUSTOMER_URL=
